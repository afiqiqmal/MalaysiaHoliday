{
    "name": "afiqiqmal/malaysiaholiday",
    "description": "to get all holidays date in malaysia",
    "type": "library",
    "keywords": ["php", "malaysia", "holiday", "laravel"],
    "license": "MIT",
    "authors": [
        {
            "name": "Hafiq",
            "email": "hafiqiqmal93@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
